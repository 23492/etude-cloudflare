{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etude-sync",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "etude-sync", "database_id": "REPLACE_WITH_D1_ID" }
  ],
  "vars": { "ALLOWED_ORIGINS": "" },
  "triggers": { "crons": ["17 3 * * 1"] }
  // R2 (later, once the token has R2 rights):
  // "r2_buckets": [ { "binding": "BLOBS", "bucket_name": "etude-sync-blobs" }, { "binding": "BACKUPS", "bucket_name": "etude-sync-backups" } ]
  // ADMIN_TOKEN is a secret: wrangler secret put ADMIN_TOKEN
}
